# MiniMax-M3.1-Flash, Quark MXFP4 export, per recipes/MiniMax-M3.md
# ("MiniMax-M3.1-Flash on 4xMI355 GPUs"). Sourced by accept.sh.

IMAGE=${IMAGE:-rocm/atom-dev:nightly_202611081546}
MODEL_PATH=${MODEL_PATH:-/share_nfs/models/amd/MiniMax-M3.1-Flash-Quark-MXFP4}
SERVED_MODEL=minimax-m3.1

# Shared storage every node mounts at the same path: the cache (lmms-eval
# source, the ATOMesh build), the results directory and the HF cache.
ACCEPT_DIR=${ACCEPT_DIR:-/share_nfs/junyan_tmp_r120/accept}
HF_HOME=${HF_HOME:-/share_nfs/junyan_tmp_r120/hf}
MOUNTS=(/share_nfs/junyan_tmp_r120 "$MODEL_PATH")

# Roles: <ROLE>_NODE is the host the role's container runs on, <ROLE>_GPUS
# the GPUs its server sees. A role without GPUs gets no GPU devices.
ATOM_NODE=${ATOM_NODE:-pit2-p03-g07}
ATOM_GPUS=${ATOM_GPUS:-0,1,2,3}
MESH_NODE=${MESH_NODE:-pit2-p03-g07}
CLIENT_NODE=${CLIENT_NODE:-pit2-p03-g07}

# Ports on the host network; set PORT_BASE to share a node with another run.
PORT_BASE=${PORT_BASE:-18600}
ATOM_PORT=$((PORT_BASE + 10))
ATOM_ENGINE_PORT=$((PORT_BASE + 6))
MESH_PORT=$((PORT_BASE + 0))
MESH_METRICS_PORT=$((PORT_BASE + 29))

ATOM_ENV=(
  AITER_LOG_LEVEL=WARNING
  ATOM_FORCE_ATTN_TRITON=1
  AITER_QUICK_REDUCE_QUANTIZATION=INT4
  ATOM_FUSE_MXFP8_SHARED_INTO_MXFP4=1
)
ATOM_ARGS=(
  --model "$MODEL_PATH"
  --served-model-name "$SERVED_MODEL"
  --tensor-parallel-size 4
  --trust-remote-code
  --default-chat-template-kwargs '{"thinking_mode": "enabled"}'
  --gpu-memory-utilization 0.9
  --block-size 128
  --max-model-len 131072
  --max-num-seqs 128
  --max-num-batched-tokens 32768
  --kv_cache_dtype fp8
  --index-cache-dtype fp8
  --online_quant_config '{"global_quant_config": "ptpc_fp8", "exclude_layer": ["lm_head", "model.embed_tokens", "vision_tower", "multi_modal_projector", "patch_merge_mlp", "*block_sparse_moe"]}'
  --no-enable_prefix_caching
  --method dspark
  --draft-model "$MODEL_PATH/dspark"
  --num-speculative-tokens 7
)

# The recipe's MMMU-Pro standard (10 options) and vision scores.
MMMU_PRO_REF_STANDARD=0.791
MMMU_PRO_REF_VISION=0.682

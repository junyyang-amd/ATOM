# Kimi-K3.1 (moonshotai/Kimi-K3.1-Pro), per recipes/Kimi-K3.1.md ("Launch":
# TP8 with DCP8, BF16 KV, FP8 index cache). Sourced by accept.sh.

# The image's AITER carries ROCm/aiter#6954 and #7067, which the recipe needs.
IMAGE=${IMAGE:-rocm/atom-dev:nightly_202611081546}
MODEL_PATH=${MODEL_PATH:-/share_nfs/models/moonshotai/Kimi-K3.1-Pro}
SERVED_MODEL=kimi-k3.1

# Shared storage every node mounts at the same path: the cache (lmms-eval
# source, the ATOMesh build), the results directory and the HF cache.
ACCEPT_DIR=${ACCEPT_DIR:-/share_nfs/junyan_tmp_r120/accept}
HF_HOME=${HF_HOME:-/share_nfs/junyan_tmp_r120/hf}
MOUNTS=(/share_nfs/junyan_tmp_r120 "$MODEL_PATH")

# Roles: <ROLE>_NODE is the host the role's container runs on, <ROLE>_GPUS
# the GPUs its server sees. TP8 takes a whole node.
ATOM_NODE=${ATOM_NODE:-pit2-p03-g24}
ATOM_GPUS=${ATOM_GPUS:-0,1,2,3,4,5,6,7}
MESH_NODE=${MESH_NODE:-pit2-p03-g24}
CLIENT_NODE=${CLIENT_NODE:-pit2-p03-g24}

# Ports on the host network; set PORT_BASE to share a node with another run.
PORT_BASE=${PORT_BASE:-18700}
ATOM_PORT=$((PORT_BASE + 10))
ATOM_ENGINE_PORT=$((PORT_BASE + 6))
MESH_PORT=$((PORT_BASE + 0))
MESH_METRICS_PORT=$((PORT_BASE + 29))

ATOM_ENV=(
  AITER_LOG_LEVEL=WARNING
)
ATOM_ARGS=(
  --model "$MODEL_PATH"
  --served-model-name "$SERVED_MODEL"
  --trust-remote-code
  --tensor-parallel-size 8
  --decode-context-parallel-size 8
  --kv_cache_dtype bf16
  --index-cache-dtype fp8
  --max-model-len 131072
  --max-num-seqs 64
  --block-size 128
)

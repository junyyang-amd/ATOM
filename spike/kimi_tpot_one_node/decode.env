# Decode server environment of CI Slurm 11899 (10.1) and 12390 (7.2.4),
# copied from the "DECODE launch info" block of rank-1/container.log; the two
# runs printed the same values apart from cache paths, host IP and base image.
# Dropped: AITER_CACHE_DIR, AITER_JIT_DIR (per-job paths), ATOM_BASE_IMAGE
# (set by the image), ATOM_HOST_IP, ATOM_TORCH_PROFILER_DIR (no profiler),
# MOONCAKE_DISABLE_HIP_DMABUF (no KV transfer).
AITER_FLYDSL_STAGE2_FP8=1
AITER_LOG_LEVEL=WARNING
AITER_QUICK_REDUCE_QUANTIZATION=INT4
AITER_REUSE_IDENTICAL_COMM_GROUPS=0
AITER_SITUV2_A4W4=1
ATOM_ENABLE_METRICS_DEVICE_TIMER=1
ATOM_ENABLE_REPLAYSSM=1
ATOM_GDN_SSM_DTYPE=fp16
ATOM_PD_RANK_MAPPING_POLICY=none
ATOM_STATE_CHECKPOINT_DEMAND=1
ATOM_USE_FLYDSL_FP8_PREFILL_ATTN=1
ATOM_USE_FLYDSL_GATHER_KV_B_PROJ=1
HIP_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
HSA_ENABLE_IPC_MODE_LEGACY=1
MORI_IB_GID_INDEX=1
MORI_RDMA_DEVICES=ionic_0,ionic_1,ionic_2,ionic_3,ionic_4,ionic_5,ionic_6,ionic_7
MORI_SOCKET_IFNAME=eno0
NCCL_CROSS_NIC=0
NCCL_DEBUG=WARN
NCCL_IB_FIFO_TC=192
NCCL_IB_GID_INDEX=1
NCCL_IB_HCA=ionic_0,ionic_1,ionic_2,ionic_3,ionic_4,ionic_5,ionic_6,ionic_7
NCCL_IB_QPS_PER_CONNECTION=1
NCCL_IB_RETRY_CNT=12
NCCL_IB_TC=104
NCCL_IB_TIMEOUT=22
NCCL_NET_DISABLE_INTRA=1
NCCL_NET_PLUGIN=none
NCCL_PXN_DISABLE=0
NCCL_SOCKET_IFNAME==eno0
PYTHONHASHSEED=0
PYTHONNOUSERSITE=1
PYTHONUNBUFFERED=1
# The CI decode node had a KV connector, which turns Kimi-K3 mono decode off
# ("Kimi-K3 mono decode off: KV connector"); without one it would arm, so keep
# the CI's decode path explicitly.
ATOM_MONO_ENABLE=0
